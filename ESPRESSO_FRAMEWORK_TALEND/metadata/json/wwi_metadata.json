    {
      "source_id": "exchange_rates",
      "source_name": "ExchangeRate-API",
      "source_type": "rest_api",
      "connection": {
        "base_url": "https://v6.exchangerate-api.com/v6",
        "auth_type": "api_key",
        "api_key_param": "9ab371befe2fd786007579e6",
        "api_key_location": "url_path"
      },
      "target": {
        "database": "WWI_RAW",
        "schema": "RAW"
      },
      "endpoints": [
        {
          "endpoint_id": "latest_eur",
          "endpoint_name": "Latest EUR Exchange Rates",
          "method": "GET",
          "url_path": "/latest/EUR",
          "full_url_template": "https://v6.exchangerate-api.com/v6/9ab371befe2fd786007579e6/latest/EUR",
          "response_format": "json",
          "response_root": "conversion_rates",
          "base_currency": "EUR",
          "schedule": "daily",
          "target_table": "EXCHANGE_RATES_EUR_LATEST",
          "load_type": "full",
          "enabled": true,
          "response_mapping": {
            "base_code": "BASE_CURRENCY",
            "time_last_update_utc": "RATE_DATE",
            "conversion_rates": "RATE_VALUE"
          },
          "target_columns": [
            {
              "name": "RATE_DATE",
              "type": "TIMESTAMP_NTZ",
              "source_field": "time_last_update_utc",
              "description": "Date/time the rate was last updated"
            },
            {
              "name": "BASE_CURRENCY",
              "type": "VARCHAR(3)",
              "source_field": "base_code",
              "description": "Base currency code (EUR)"
            },
            {
              "name": "TARGET_CURRENCY",
              "type": "VARCHAR(3)",
              "source_field": "_key",
              "description": "Target currency code from conversion_rates keys"
            },
            {
              "name": "EXCHANGE_RATE",
              "type": "NUMBER(18,6)",
              "source_field": "_value",
              "description": "Exchange rate value"
            },
            {
              "name": "LOADED_AT",
              "type": "TIMESTAMP_NTZ",
              "source_field": "_system",
              "description": "Timestamp when record was loaded into Snowflake"
            }
          ],
          "sample_response": {
            "result": "success",
            "base_code": "EUR",
            "time_last_update_utc": "Mon, 24 Feb 2025 00:00:00 +0000",
            "conversion_rates": {
              "EUR": 1,
              "USD": 1.0456,
              "GBP": 0.8312,
              "BGN": 1.9558,
              "CHF": 0.9412,
              "JPY": 157.23
            }
          },
          "notes": "The conversion_rates object contains ~160 currencies as key-value pairs. Each pair needs to be unpivoted into rows (one row per currency) before loading into Snowflake."
        }
      ]
    }
